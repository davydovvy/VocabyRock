# Copy to .env and use a strong private password.
ADMIN_PASSWORD=change-me
PORT=8787
# Synology example: /volume1/docker/vacabyrock/data
DATA_PATH=./data
# Match ownership of DATA_PATH; container default is 10001:10001.
PUID=10001
PGID=10001
# Set true only when serving over HTTPS.
COOKIE_SECURE=false
# Optional: enables parent search for word pictures from Pixabay.
PIXABAY_API_KEY=
